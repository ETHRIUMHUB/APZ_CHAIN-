import React, { useState, useEffect, useCallback } from 'react';
import {
  SafeAreaView, ScrollView, View, Text, TextInput,
  TouchableOpacity, StyleSheet, Alert, ActivityIndicator,
} from 'react-native';
import '@walletconnect/react-native-compat';
import { ethers } from 'ethers';
import WalletConnectProvider from '@walletconnect/react-native-dapp';

// ─── تنظیمات شبکه ───
const CONFIG = {
  chainId: 1337,
  rpcUrl: 'http://10.0.2.2:8545',
  walletConnectProjectId: 'YOUR_WALLETCONNECT_PROJECT_ID',
  addresses: {
    token: '0x5FbDB2315678afecb367f032d93F642f64180aa3',
    staking: '0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512',
    governance: '0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0',
  },
};

const TOKEN_ABI = [
  'function balanceOf(address) view returns (uint256)',
  'function totalSupply() view returns (uint256)',
  'function approve(address, uint256) returns (bool)',
  'function allowance(address, address) view returns (uint256)',
];

const STAKING_ABI = [
  'function stake(uint256)',
  'function withdraw(uint256)',
  'function getReward()',
  'function exit()',
  'function balanceOf(address) view returns (uint256)',
  'function earned(address) view returns (uint256)',
];

const GOVERNANCE_ABI = [
  'function createProposal(string)',
  'function vote(uint256, bool)',
  'function getProposal(uint256) view returns (uint256,address,string,uint256,uint256,uint256,uint256,bool)',
  'function proposalCount() view returns (uint256)',
];

// ─── کامپوننت اصلی ───
export default function App() {
  const [provider, setProvider] = useState<ethers.BrowserProvider | null>(null);
  const [signer, setSigner] = useState<ethers.Signer | null>(null);
  const [account, setAccount] = useState<string>('');
  const [balance, setBalance] = useState('0.00');
  const [staked, setStaked] = useState('0.00');
  const [earned, setEarned] = useState('0.00');
  const [stakeAmount, setStakeAmount] = useState('10');
  const [loading, setLoading] = useState(false);
  const [activeTab, setActiveTab] = useState<'dashboard' | 'staking' | 'governance'>('dashboard');
  const [proposals, setProposals] = useState<any[]>([]);

  // ─── اتصال کیف پول ───
  const connectWallet = useCallback(async () => {
    try {
      setLoading(true);
      const connector = new WalletConnectProvider({
        projectId: CONFIG.walletConnectProjectId,
        chains: [CONFIG.chainId],
        showQrModal: true,
        rpcMap: { [CONFIG.chainId]: CONFIG.rpcUrl },
        metadata: {
          name: 'APZ-Chain',
          description: 'شبکه غیرمتمرکز یادگیری',
          url: 'https://apz-chain.io',
          icons: ['https://via.placeholder.com/192/7c3aed/ffffff?text=APZ'],
        },
      });

      await connector.enable();
      const ethersProvider = new ethers.BrowserProvider(connector);
      const ethersSigner = await ethersProvider.getSigner();
      const address = await ethersSigner.getAddress();

      setProvider(ethersProvider);
      setSigner(ethersSigner);
      setAccount(address);

      Alert.alert('موفق', `کیف پول متصل شد: ${address.slice(0, 6)}...${address.slice(-4)}`);
      await refreshDashboard(ethersProvider, address);
    } catch (e: any) {
      Alert.alert('خطا', 'اتصال کیف پول ناموفق بود: ' + (e.message || 'ناشناخته'));
    } finally {
      setLoading(false);
    }
  }, []);

  // ─── به‌روزرسانی داشبورد ───
  const refreshDashboard = useCallback(async (prov: ethers.BrowserProvider, addr: string) => {
    try {
      const token = new ethers.Contract(CONFIG.addresses.token, TOKEN_ABI, prov);
      const staking = new ethers.Contract(CONFIG.addresses.staking, STAKING_ABI, prov);

      const [bal, stk, ern] = await Promise.all([
        token.balanceOf(addr).catch(() => 0n),
        staking.balanceOf(addr).catch(() => 0n),
        staking.earned(addr).catch(() => 0n),
      ]);

      setBalance(ethers.formatUnits(bal, 18));
      setStaked(ethers.formatUnits(stk, 18));
      setEarned(ethers.formatUnits(ern, 18));
    } catch (e) {
      console.warn('Refresh error:', e);
    }
  }, []);

  // ─── استیک ───
  const handleStake = useCallback(async () => {
    if (!signer || !provider || !account) return Alert.alert('خطا', 'ابتدا کیف پول را متصل کنید');
    const amount = parseFloat(stakeAmount);
    if (!amount || amount <= 0) return Alert.alert('خطا', 'مقدار معتبر وارد کنید');

    try {
      setLoading(true);
      const token = new ethers.Contract(CONFIG.addresses.token, TOKEN_ABI, signer);
      const staking = new ethers.Contract(CONFIG.addresses.staking, STAKING_ABI, signer);
      const wei = ethers.parseUnits(amount.toString(), 18);

      const allowance = await token.allowance(account, CONFIG.addresses.staking);
      if (allowance < wei) {
        const approveTx = await token.approve(CONFIG.addresses.staking, wei);
        await approveTx.wait();
      }

      const tx = await staking.stake(wei);
      await tx.wait();
      Alert.alert('موفق', 'استیک با موفقیت انجام شد ✅');
      await refreshDashboard(provider, account);
    } catch (e: any) {
      Alert.alert('خطا', e.reason || e.message || 'تراکنش ناموفق');
    } finally {
      setLoading(false);
    }
  }, [signer, provider, account, stakeAmount, refreshDashboard]);

  // ─── بارگذاری پیشنهادات ───
  const loadProposals = useCallback(async () => {
    if (!provider || !account) return;
    try {
      const gov = new ethers.Contract(CONFIG.addresses.governance, GOVERNANCE_ABI, provider);
      const count = Number(await gov.proposalCount());
      const items = [];
      for (let i = 1; i <= count; i++) {
        const p = await gov.getProposal(i);
        items.push({
          id: i,
          desc: p[2],
          forVotes: ethers.formatUnits(p[3], 18),
          againstVotes: ethers.formatUnits(p[4], 18),
          executed: p[7],
        });
      }
      setProposals(items);
    } catch (e) {
      console.warn('Load proposals error:', e);
    }
  }, [provider, account]);

  // ─── رأی‌دهی ───
  const voteProposal = useCallback(async (id: number, support: boolean) => {
    if (!signer) return Alert.alert('خطا', 'ابتدا کیف پول را متصل کنید');
    try {
      setLoading(true);
      const gov = new ethers.Contract(CONFIG.addresses.governance, GOVERNANCE_ABI, signer);
      const tx = await gov.vote(id, support);
      await tx.wait();
      Alert.alert('موفق', 'رأی شما ثبت شد ✅');
      await loadProposals();
    } catch (e: any) {
      Alert.alert('خطا', e.reason || e.message);
    } finally {
      setLoading(false);
    }
  }, [signer, loadProposals]);

  useEffect(() => {
    if (activeTab === 'governance') loadProposals();
  }, [activeTab, loadProposals]);

  // ─── رندر ───
  return (
    <SafeAreaView style={styles.container}>
      {/* Header */}
      <View style={styles.header}>
        <View style={styles.brandRow}>
          <View style={styles.logo}><Text style={styles.logoText}>AP</Text></View>
          <View>
            <Text style={styles.brandName}>APZ<Text style={styles.brandAccent}>Chain</Text></Text>
            <Text style={styles.brandSub}>Asanpardaz Zagros</Text>
          </View>
        </View>
        <TouchableOpacity
          style={[styles.walletBtn, account && styles.walletBtnConnected]}
          onPress={account ? () => {} : connectWallet}
        >
          <Text style={styles.walletBtnText}>
            {account ? `${account.slice(0, 6)}...${account.slice(-4)}` : 'اتصال'}
          </Text>
        </TouchableOpacity>
      </View>

      {/* Loading overlay */}
      {loading && (
        <View style={styles.loadingOverlay}>
          <ActivityIndicator size="large" color="#7c3aed" />
          <Text style={styles.loadingText}>در حال پردازش...</Text>
        </View>
      )}

      {/* Tabs */}
      <View style={styles.tabs}>
        {(['dashboard', 'staking', 'governance'] as const).map(tab => (
          <TouchableOpacity
            key={tab}
            style={[styles.tab, activeTab === tab && styles.tabActive]}
            onPress={() => setActiveTab(tab)}
          >
            <Text style={[styles.tabText, activeTab === tab && styles.tabTextActive]}>
              {tab === 'dashboard' ? 'داشبورد' : tab === 'staking' ? 'استیکینگ' : 'حاکمیت'}
            </Text>
          </TouchableOpacity>
        ))}
      </View>

      <ScrollView style={styles.content} contentContainerStyle={styles.contentPadding}>
        {/* ─── Dashboard ─── */}
        {activeTab === 'dashboard' && (
          <>
            <View style={styles.balanceCard}>
              <Text style={styles.balanceLabel}>موجودی توکن APZ</Text>
              <Text style={styles.balanceAmount}>{balance} <Text style={styles.balanceUnit}>APZ</Text></Text>
              <View style={styles.balanceRow}>
                <View style={styles.balanceItem}>
                  <Text style={styles.balanceItemLabel}>🔒 استیک شده</Text>
                  <Text style={styles.balanceItemValue}>{staked}</Text>
                </View>
                <View style={styles.balanceItem}>
                  <Text style={styles.balanceItemLabel}>🎁 پاداش</Text>
                  <Text style={[styles.balanceItemValue, { color: '#a78bfa' }]}>{earned}</Text>
                </View>
              </View>
            </View>

            <View style={styles.actionGrid}>
              {[
                { icon: '💰', label: 'استیکینگ', tab: 'staking' },
                { icon: '⚖️', label: 'حاکمیت', tab: 'governance' },
                { icon: '📚', label: 'آموزش' },
                { icon: '🎧', label: 'پشتیبانی' },
              ].map((a, i) => (
                <TouchableOpacity
                  key={i}
                  style={styles.actionBtn}
                  onPress={() => a.tab && setActiveTab(a.tab as any)}
                >
                  <Text style={styles.actionIcon}>{a.icon}</Text>
                  <Text style={styles.actionLabel}>{a.label}</Text>
                </TouchableOpacity>
              ))}
            </View>
          </>
        )}

        {/* ─── Staking ─── */}
        {activeTab === 'staking' && (
          <View style={styles.card}>
            <Text style={styles.cardTitle}>💰 استیکینگ APZ</Text>
            <Text style={styles.label}>مقدار APZ</Text>
            <TextInput
              style={styles.input}
              value={stakeAmount}
              onChangeText={setStakeAmount}
              keyboardType="decimal-pad"
              placeholder="0.0"
              placeholderTextColor="#475569"
            />
            <TouchableOpacity style={styles.btnPrimary} onPress={handleStake}>
              <Text style={styles.btnText}>🔒 استیک</Text>
            </TouchableOpacity>

            <View style={styles.statsGrid}>
              <View style={styles.statCard}>
                <Text style={styles.statLabel}>🔒 سهم شما</Text>
                <Text style={styles.statValue}>{staked}</Text>
              </View>
              <View style={styles.statCard}>
                <Text style={styles.statLabel}>🎁 پاداش شما</Text>
                <Text style={[styles.statValue, { color: '#4ade80' }]}>{earned}</Text>
              </View>
            </View>
          </View>
        )}

        {/* ─── Governance ─── */}
        {activeTab === 'governance' && (
          <View style={styles.card}>
            <Text style={styles.cardTitle}>⚖️ پیشنهادات حاکمیت</Text>
            {proposals.length === 0 ? (
              <Text style={styles.emptyText}>هنوز پیشنهادی ثبت نشده است</Text>
            ) : (
              proposals.map(p => (
                <View key={p.id} style={styles.proposal}>
                  <Text style={styles.proposalId}>#{p.id}</Text>
                  <Text style={styles.proposalDesc}>{p.desc}</Text>
                  <View style={styles.proposalStats}>
                    <Text>👍 {p.forVotes}</Text>
                    <Text>👎 {p.againstVotes}</Text>
                  </View>
                  {!p.executed && (
                    <View style={styles.voteRow}>
                      <TouchableOpacity
                        style={[styles.voteBtn, styles.voteFor]}
                        onPress={() => voteProposal(p.id, true)}
                      >
                        <Text style={styles.voteText}>👍 موافق</Text>
                      </TouchableOpacity>
                      <TouchableOpacity
                        style={[styles.voteBtn, styles.voteAgainst]}
                        onPress={() => voteProposal(p.id, false)}
                      >
                        <Text style={styles.voteText}>👎 مخالف</Text>
                      </TouchableOpacity>
                    </View>
                  )}
                </View>
              ))
            )}
          </View>
        )}
      </ScrollView>
    </SafeAreaView>
  );
}

